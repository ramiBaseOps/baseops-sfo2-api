# Copy these into Railway → service → Variables. Never commit real values.

# --- Email (Resend, over HTTP) ---
# Railway blocks outbound SMTP on both 465 and 587 (ETIMEDOUT, confirmed via
# /selftest), so mail cannot go through Zoho SMTP from here. Resend's HTTP API
# is not blocked.
RESEND_API_KEY=

# Until baseops.tech is verified in Resend, use onboarding@resend.dev — it only
# delivers to the address that owns the Resend account.
MAIL_FROM=rami@baseops.tech

# Comma separated. One message is sent per address, so a bounce for one
# cannot suppress delivery to the other.
LEAD_TO=ramitri@gmail.com,pichardolg@yahoo.com

# --- Airtable (SFO2 Ops → Leads) ---
AIRTABLE_TOKEN=
AIRTABLE_BASE=appGvoqN6e4VcVIwJ
AIRTABLE_TABLE=tblq7jarByWetjgie

# --- Browser origins allowed to POST /lead ---
ALLOWED_ORIGINS=https://www.baseops.tech,https://baseops.tech

# --- Offer ---
OFFER_PRICE=75

# --- Paragon hosted checkout ---
# From PUREsight → Hosted Page → Misc → Generate. Generating a NEW pair
# invalidates the old one — retrieve the existing values rather than
# regenerating if they are already in use.
# While any of these three are blank, payment_url comes back null and the
# landing page falls back to WellnessLiving checkout.
PARAGON_HP_USER=
PARAGON_HP_PASS=
PARAGON_MERCHANT_KEY=128591

# Stage defaults. For production, drop the "stage." prefixes.
PARAGON_TOKEN_URL=https://stage.paragonsolutions.com/api/v2/hp/token
PARAGON_PAY_BASE=https://stage.shpp.paragonsolutions.com/payment

# --- Twilio SMS ---
# Transactional payment confirmations only. Nothing promotional goes out on
# this path — the consent checkbox on the form is optional and unticked by
# default, and marketing to someone who did not tick it is what it exists to
# prevent. Anything promotional must be gated on SMS Opt-in in Airtable.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+1201XXXXXXX

# --- Studio details used in the SMS ---
# CLASS_SCHEDULE is "dayOfWeek:hour24:label", comma separated. Sunday = 0.
# UNCONFIRMED by Mario as of 2026-09-17 — lives here so it can be corrected
# without a deploy.
CLASS_SCHEDULE=1:19:7pm,6:12:12pm
STUDIO_PHONE=201-792-1616
STUDIO_ADDRESS=83 Franklin St, Jersey City
