# Copy these into Railway → service → Variables. Never commit real values.

# --- Email (Resend, over HTTP) ---
# Railway blocks outbound SMTP on both 465 and 587 (ETIMEDOUT, confirmed via
# /selftest), so mail cannot go through Zoho SMTP from here. Resend's HTTP API
# is not blocked.
RESEND_API_KEY=

# Until baseops.tech is verified in Resend, use onboarding@resend.dev — it only
# delivers to the address that owns the Resend account.
MAIL_FROM=rami@baseops.tech

# Comma separated. One message is sent per address, so a bounce for one
# cannot suppress delivery to the other.
LEAD_TO=ramitri@gmail.com,pichardolg@yahoo.com

# --- Airtable (SFO2 Ops → Leads) ---
AIRTABLE_TOKEN=
AIRTABLE_BASE=appGvoqN6e4VcVIwJ
AIRTABLE_TABLE=tblq7jarByWetjgie

# --- Browser origins allowed to POST /lead ---
ALLOWED_ORIGINS=https://www.baseops.tech,https://baseops.tech

# --- Offer ---
OFFER_PRICE=75
